---
import SectionShell from '../SectionShell.astro';
import { projects } from '../../data/projects';
---

<SectionShell id="projects" title="Selected work" kicker="Projects">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <article class="glass group flex min-w-0 flex-col overflow-hidden rounded-2xl transition hover:border-accent/30">
          {project.image && (
            <img
              src={project.image}
              alt={project.imageAlt ?? ''}
              width={1600}
              height={1000}
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full border-b border-line/60 object-cover"
            />
          )}
          <div class="flex min-w-0 flex-1 flex-col p-6">
            <h3 class="font-display text-lg font-bold break-words transition group-hover:text-accent">
              {project.name}
            </h3>
            <p class="mt-3 flex-1 text-sm break-words text-muted">{project.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((t) => (
                <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
                  {t}
                </li>
              ))}
            </ul>
            {(project.href || project.repo) && (
              <div class="mt-5 flex gap-4 text-sm">
                {project.href && (
                  <a href={project.href} class="text-accent underline-offset-4 hover:underline">
                    Live ↗
                  </a>
                )}
                {project.repo && (
                  <a href={project.repo} class="text-accent underline-offset-4 hover:underline">
                    Code ↗
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</SectionShell>
