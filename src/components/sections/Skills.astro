---
import SectionShell from '../SectionShell.astro';
import { skillGroups } from '../../data/skills';
---

<SectionShell id="skills" title="Skills" kicker="Toolbox">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skillGroups.map((group) => (
        <div class="glass rounded-2xl p-6 transition hover:border-accent/30">
          <h3 class="font-display text-lg font-bold">{group.title}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</SectionShell>
