---
import SectionShell from '../SectionShell.astro';
import { experience } from '../../data/experience';
---

<SectionShell id="experience" title="Experience" kicker="03 · Journey">
  <ol class="relative space-y-10 border-l border-line pl-8">
    {
      experience.map((entry) => (
        <li class="relative">
          <span
            class="absolute top-1.5 -left-[2.42rem] size-3 rounded-full bg-accent shadow-[0_0_12px_var(--color-accent)]"
            aria-hidden="true"
          />
          <p class="font-mono text-sm text-muted">{entry.period}</p>
          <h3 class="mt-1 font-display text-xl font-bold">
            {entry.role} <span class="text-accent">· {entry.company}</span>
          </h3>
          <p class="mt-2 text-muted">{entry.summary}</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
            {entry.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</SectionShell>
