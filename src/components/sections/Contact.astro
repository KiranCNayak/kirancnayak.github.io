---
import SectionShell from '../SectionShell.astro';
import { site } from '../../data/site';
---

<SectionShell id="contact" title="Let's talk" kicker="05 · Contact">
  <div class="glass mx-auto max-w-2xl rounded-2xl p-10 text-center">
    <p class="text-muted">
      Whether it's an interesting problem, a collaboration, or just to say hi — my inbox is open.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="glow-text mt-6 inline-block font-display text-2xl font-bold sm:text-3xl"
    >
      {site.email}
    </a>
    <div class="mt-8 flex justify-center gap-6 text-sm text-muted">
      {
        site.socials.map((social) => (
          <a href={social.href} class="transition hover:text-accent" rel="me noopener">
            {social.label}
          </a>
        ))
      }
    </div>
  </div>
</SectionShell>
