---
import SectionShell from '../SectionShell.astro';
---

<SectionShell id="about" title="About me" kicker="01 · About">
  <div class="grid gap-10 md:grid-cols-[2fr_1fr]">
    <div class="space-y-4 leading-relaxed text-muted">
      <!-- PLACEHOLDER — write your real bio here -->
      <p>
        Hi, I'm Kiran. This is placeholder bio text — replace it with a few sentences about who you
        are, what you build, and what drives you as an engineer.
      </p>
      <p>
        A second paragraph works well for what you're currently exploring or learning, tying back to
        the footer motto: learning is a journey, not a destination.
      </p>
    </div>
    <div class="glass flex items-center justify-center rounded-2xl p-8">
      <span class="glow-text font-display text-6xl font-bold">KN</span>
    </div>
  </div>
</SectionShell>
