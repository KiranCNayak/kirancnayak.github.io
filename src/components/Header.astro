---
import { site } from '../data/site';

const links = [
  { label: 'About', href: '/#about' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Contact', href: '/#contact' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="fixed inset-x-0 top-0 z-40">
  <nav
    class="glass mx-auto mt-4 flex max-w-5xl items-center justify-between rounded-full px-5 py-2.5 max-sm:mx-3"
  >
    <a href="/" class="glow-text font-display text-lg font-bold" aria-label={site.name}>
      {site.monogram}
    </a>
    <ul class="flex items-center gap-1 text-sm text-muted max-sm:gap-0">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-1.5 transition-colors hover:bg-white/5 hover:text-ink max-sm:px-2"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
