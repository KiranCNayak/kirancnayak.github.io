---
import { site } from '../data/site';
import { version } from '../lib/version';

const year = new Date().getFullYear();
---

<footer class="border-t border-line/60 py-10">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-6 text-center text-sm text-muted"
  >
    <p class="font-display italic">“{site.footerText}”</p>
    <div class="flex gap-4">
      {
        site.socials.map((social) => (
          <a href={social.href} class="transition-colors hover:text-accent" rel="me noopener">
            {social.label}
          </a>
        ))
      }
    </div>
    <p>© {year} {site.name}</p>
    {
      version.sha ? (
        <a
          href={`https://github.com/KiranCNayak/kirancnayak.github.io/commit/${version.sha}`}
          title={`Deployed ${version.deployedAt}`}
          class="font-mono text-xs text-muted/60 transition-colors hover:text-accent"
        >
          v{version.label}
        </a>
      ) : (
        <span class="font-mono text-xs text-muted/60">v{version.label}</span>
      )
    }
  </div>
</footer>
