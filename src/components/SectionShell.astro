---
interface Props {
  id: string;
  title: string;
  kicker?: string;
}

const { id, title, kicker } = Astro.props;
---

<section id={id} class="scroll-mt-24 py-20">
  <div class="mx-auto max-w-5xl px-6">
    <div data-reveal>
      {kicker && <p class="font-mono text-sm tracking-widest text-accent uppercase">{kicker}</p>}
      <h2 class="mt-2 font-display text-3xl font-bold sm:text-4xl">{title}</h2>
    </div>
    <div class="mt-10" data-reveal>
      <slot />
    </div>
  </div>
</section>
