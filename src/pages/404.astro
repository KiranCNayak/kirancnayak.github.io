---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not found" description="This page does not exist.">
  <div class="flex min-h-svh flex-col items-center justify-center px-6 text-center">
    <p class="glow-text font-display text-8xl font-bold">404</p>
    <p class="mt-4 text-muted">This page drifted off into the void.</p>
    <a
      href="/"
      class="mt-8 rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg transition hover:opacity-90"
    >
      Back home
    </a>
  </div>
</BaseLayout>
