{
  "name": "knayak.fyi",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "test:e2e": "playwright test tests/e2e/audit.spec.ts",
    "test:screenshots": "playwright test tests/e2e/screenshots.spec.ts --grep @shot",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,mjs,js}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "~0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.185.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0"
  }
}
